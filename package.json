{
  "name": "agentic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:agentic": "bun scripts/install.ts",
    "dev": "bun scripts/dev.ts",
    "dev:server": "bun run --filter @agentic/server dev",
    "dev:dashboard": "bun run --filter @agentic/dashboard dev",
    "build": "bun run --filter @agentic/dashboard build && bun run --filter @agentic/server build",
    "start": "bun run --filter @agentic/server start"
  }
}
